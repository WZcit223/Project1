# Copy to .env and adjust. Never commit .env.
# Environment name: dev | test | demo
IAI_ENV=dev
# Log level: DEBUG | INFO | WARNING | ERROR
IAI_LOG_LEVEL=INFO
# Root directory for local data (raw M5 files live in <IAI_DATA_DIR>/raw/, outside Git)
IAI_DATA_DIR=./data
# SQLite database for catalog / experiment metadata (introduced in Phase 1-2)
IAI_DATABASE_URL=sqlite:///./data/processed/industrial_ai.sqlite
# Reference data the API may use, as JSON {reference_id: directory}. Clients send only the id.
IAI_REFERENCE_DIRS={"m5_subset": "./data/reference/m5_subset"}
# Application API bind address (localhost only by default; no authentication in v0.1)
IAI_API_HOST=127.0.0.1
IAI_API_PORT=8000
